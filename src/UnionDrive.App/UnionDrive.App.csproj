<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.3</Version>
    <Product>Webdav Connetor</Product>
    <Title>Webdav Connetor</Title>
    <Description>Webdav Connetor</Description>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyName>UnionDrive</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/app.ico" LogicalName="UnionDrive.App.Assets.app.ico" />
  </ItemGroup>
</Project>
